{
  "name": "@studyverce/socket-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import dotenv/config src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node25 --format=esm --outfile=dist/index.js --external:express --external:cors --external:socket.io --external:@socket.io/redis-adapter --external:ioredis --external:jsonwebtoken --external:jose --external:pg --external:@supabase/supabase-js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@studyverce/rate-limit": "workspace:*",
    "@studyverce/redis": "workspace:*",
    "@studyverce/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.8",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.5",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^25.8.1",
    "@types/pg": "^8.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
